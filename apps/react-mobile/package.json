{
  "name": "@careconnect/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "CareConnect mobile (React Native / Expo) — medication and appointment support for adults with ADHD and their caregivers. SWEN 661 (UMGC, Fall 2026), Team E-Echo, Week 5. Feature-parity port of apps/mobile-flutter.",
