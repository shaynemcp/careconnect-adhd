    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-native": "^4.1.0",
    "globals": "^15.13.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.18.0"
